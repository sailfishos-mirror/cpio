# --no-absolute-filenames must not rewrite symbolic link targets.  A
# symlink target is stored verbatim and is resolved only when the link
# is followed, so stripping a leading `/' or `../' from it silently
# makes the link point somewhere else.  Hard link targets, which name
# another member of the same archive, are still stripped.

AT_SETUP([--no-absolute-filenames keeps symlink targets (tar format)])
AT_KEYWORDS([symlink-tar-abs])

AT_CHECK([
file --help >/dev/null 2>&1 || AT_SKIP_TEST

AT_DATA([filelist],
[abslink
dotdotlink
])

mkdir dir
cd dir

ln -s /absolute/file/name abslink
ln -s ../relative/file/name dotdotlink
cpio -o -H ustar < ../filelist > ../test.tar

cd ..

mkdir out
cd out
cpio -i --no-absolute-filenames < ../test.tar
file -h abslink dotdotlink | sed -n 's/:.*symbolic link to/:/p'
],
[0],
[abslink: /absolute/file/name
dotdotlink: ../relative/file/name
],
[ignore])

AT_CLEANUP
